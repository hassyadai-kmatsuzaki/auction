APP_NAME="日本メダカオンライン市場"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# === Reverb (WebSocket) ===
REVERB_APP_ID=auction-local
REVERB_APP_KEY=auction-local-key
REVERB_APP_SECRET=auction-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# === Pusher (レガシー・ロールバック用) ===
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=ap3
# VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
# VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# === Redis ===
# Docker開発環境: REDIS_HOST=redis
# ローカル開発: REDIS_HOST=127.0.0.1
# AWS本番: REDIS_HOST=your-cluster.xxxxx.0001.apne1.cache.amazonaws.com
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI (AI機能用)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# === AWS インフラスケーリング（管理画面からの手動切替用）===
# 管理画面から Lambda を呼び出してスケーリングするために必要
AWS_EC2_INSTANCE_ID=
AWS_NORMAL_INSTANCE_TYPE=t3.small
AWS_AUCTION_INSTANCE_TYPE=c6i.2xlarge
AWS_LAMBDA_SCALE_UP=auction-scale-up
AWS_LAMBDA_SCALE_DOWN=auction-scale-down

# === Square 決済（年会費徴収）===
# sandbox / production
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Webhook受信URL（Square管理画面に登録したものと一致させる）
SQUARE_WEBHOOK_URL=
SQUARE_CURRENCY=JPY
SQUARE_API_VERSION=2024-10-17

# フロント用（Vite でバンドルされる）
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
VITE_SQUARE_ENVIRONMENT=sandbox

# A-13: IAM Role 運用時の AWS 認証情報をホスト内で共有キャッシュ（false で無効）
AWS_CREDENTIAL_CACHE=true
# B-8: 画像変換の排他。他プロセスの変換完了を待つ秒数 / ロック保持上限
MEDIA_CONVERT_WAIT_SECONDS=8
MEDIA_CONVERT_LOCK_SECONDS=20
